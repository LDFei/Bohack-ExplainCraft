{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lingjing",
  "mainBinaryName": "lingjing",
  "version": "0.1.0",
  "identifier": "com.explaincraft.lingjing",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http://127.0.0.1:*",
        "media-src": "'self' blob: http://127.0.0.1:*",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:*",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../public/media/": "media/"
    }
  }
}
