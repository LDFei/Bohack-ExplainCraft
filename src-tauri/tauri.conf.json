{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lingjing",
  "mainBinaryName": "lingjing",
  "version": "0.1.0",
  "identifier": "com.explaincraft.lingjing",
  "build": {
    "beforeDevCommand": "npm --prefix ../front run dev:studio",
    "devUrl": "http://127.0.0.1:5173/studio.html",
    "beforeBuildCommand": "npm --prefix ../front run build:studio",
    "frontendDist": "../front/dist/studio"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: explaincraft: http://explaincraft.localhost",
        "media-src": "'self' blob: explaincraft: http://explaincraft.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../shared/public/media/": "media/"
    }
  }
}
