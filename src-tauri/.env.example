# 复制为 src-tauri/.env 后填写。.env 已加入 .gitignore，密钥不要提交到仓库。

# ---- 各环节使用的供应商 ----
# llm1 文案/分镜/剪辑、llm2 画面、llm3 背景音：demo | siliconflow
PROVIDER_LLM1=siliconflow
PROVIDER_LLM2=siliconflow
PROVIDER_LLM3=siliconflow
# llm4 配音：demo | breeze（本地 ComfyUI + breezeTTS2）
PROVIDER_LLM4=breeze
# 渲染：demo | quercus（需以 --features quercus 编译）
PROVIDER_RENDERER=quercus

# ---- 硅基流动（https://cloud.siliconflow.cn） ----
LLM1_API_KEY=
LLM1_MODEL=zai-org/GLM-5.3
LLM2_API_KEY=
LLM2_MODEL=Qwen/Qwen-Image
LLM3_API_KEY=
LLM3_MODEL=MiniMaxAI/MiniMax-H3

# ---- 本地配音：ComfyUI + breezeTTS2（语音克隆） ----
COMFYUI_URL=http://127.0.0.1:8188
BREEZE_MODEL='int8 hybrid (recommended)'
# 参考音；同名 .json（lines[].text）或 .txt 为转写文本。
# Windows 路径请用单引号包裹，例如 BREEZE_VOICE_MALE='D:\voices\male.wav'
BREEZE_VOICE_MALE=
BREEZE_VOICE_FEMALE=
