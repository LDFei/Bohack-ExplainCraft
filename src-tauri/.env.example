# 复制为 src-tauri/.env 后填写。.env 已加入 .gitignore，密钥不要提交到仓库。

# ---- 各环节使用的供应商 ----
# llm1 文案/对话/分镜/SVG：openai | aliyun | deepseek | minimax | siliconflow | glm | custom
PROVIDER_LLM1=siliconflow
# llm3 编曲供应商：procedural（本地合成，默认）| stable_audio | siliconflow | minimax
# 新项目默认 music_mode=auto，使用本地程序化配乐，不需要音乐 API 密钥。
PROVIDER_LLM3=procedural
# llm4 配音：qwen/aliyun | indextts | breeze
PROVIDER_LLM4=qwen
# 默认通过 Quercus 剪辑与导出，需要 FFmpeg 开发包
PROVIDER_RENDERER=quercus
FFMPEG_PATH=ffmpeg

# ---- 文案模型 ----
LLM1_API_KEY=
LLM1_MODEL=zai-org/GLM-5.3

# ---- 创作与 SVG 共用的 LLM（OpenAI 兼容）----
# 预设 base URL：
# openai=https://api.openai.com/v1
# aliyun=https://dashscope.aliyuncs.com/compatible-mode/v1
# deepseek=https://api.deepseek.com/v1
# minimax=https://api.minimaxi.com/v1
# siliconflow=https://api.siliconflow.cn/v1
# glm=https://open.bigmodel.cn/api/paas/v4
# LLM1_BASE_URL 留空时按 PROVIDER_LLM1 自动选择；custom 时必须手动填写。
LLM1_BASE_URL=

# ---- 编曲 ----
LLM3_BASE_URL=
LLM3_API_KEY=
LLM3_MODEL=deterministic-wav-v1
# Stable Audio 使用 PROVIDER_LLM3=stable_audio，并复用 LLM3_API_KEY。

# ---- 阿里云 Qwen-TTS ----
QWEN_TTS_API_KEY=
QWEN_TTS_MODEL=qwen-tts
QWEN_TTS_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TTS_VOICE=Cherry

# ---- 硅基流动 TTS ----
SILICONFLOW_TTS_API_KEY=
SILICONFLOW_TTS_MODEL=fnlp/MOSS-TTSD-v0.5
SILICONFLOW_TTS_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_TTS_VOICE=
# 创作页可选声线，逗号分隔；也允许每次手动填写。
TTS_VOICES=alex,anna,bella,claire,diana,eric,jason,joanna,joseph,julia,liam,lily,mark,molly,noah,oliver,ryan,sophia,tony,uk,Cherry,Ethan,Serena

# ---- 本地 IndexTTS（OpenAI audio/speech 兼容）----
INDEXTTS_BASE_URL=http://127.0.0.1:8000/v1
INDEXTTS_MODEL=indextts
INDEXTTS_VOICE=default

# ---- 本地配音：ComfyUI + breezeTTS2（语音克隆） ----
COMFYUI_URL=http://127.0.0.1:8188
BREEZE_MODEL='int8 hybrid (recommended)'
# 参考音；同名 .json（lines[].text）或 .txt 为转写文本。
# Windows 路径请用单引号包裹，例如 BREEZE_VOICE_MALE='D:\voices\male.wav'
BREEZE_VOICE_MALE=
BREEZE_VOICE_FEMALE=
