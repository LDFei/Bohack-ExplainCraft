  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "3.10.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vue-tsc": "^3.0.0"
  }
}
